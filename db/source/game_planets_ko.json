 "biomes": {
  "arctic_glacier_base": {
   "en": "Submerged in eternal winter, this world's frosty peaks glimmer in the light of its too-distant star.",
   "ko": "영원한 겨울에 잠긴 이 세계의 서리 낀 봉우리들은 너무나도 먼 별빛 속에서 희미하게 빛납니다."
  },
  "arctic_glacier_coldrocky": {
   "en": "Ice and moss-covered rock can be found across most of the surface of this planet.",
   "ko": "얼음과 이끼로 덮인 바위가 행성의 표면 대부분에서 발견됩니다."
  },
  "magma_base": {
   "en": "Constant eruptions keep this planet covered in lava flows and utterly inhospitable to Democratic life. It also makes it a treasure trove of rare minerals.",
   "ko": "끊임없는 화산 분출로 인해 이 행성은 용암류로 뒤덮여 있어 민주적 생명체가 살기에 전혀 적합하지 않습니다. 또한 이로 인해 희귀한 광물의 보고가 되기도 했습니다."
  },
  "moor_arid": {
   "en": "Scorching temperatures, high winds, and low precipitation cause a near-constant cycle of fires to sweep this planet, punctuated by short bursts of lush rebirth between infernos.",
   "ko": "불타는 듯한 기온, 높은 풍량, 낮은 강수량으로 인해 일정 주기의 화염이 행성을 휩쓸고, 불지옥 사이에 짧고 무성한 부활이 폭발하듯 이루어집니다."
  },
  "moor_baseplanet": {
   "en": "Rocky outcroppings punctuate fields of tall grass in a planet dominated by misty highland terrain.",
   "ko": "안개 낀 고원 지형이 지배적인 행성에서 바위 돌출부가 키 큰 풀밭을 관통하고 있습니다."
  },
  "moor_red": {
   "en": "A crimson algae has propagated wildly across this entire planet, coating its rocky hills with a constant red that masks the spilt blood of the heroes who defend it from tyranny.",
   "ko": "선홍색 조류가 행성 전체에 널리 퍼져 바위 언덕을 붉은색으로 뒤덮었고, 이는 폭정으로부터 행성을 지킨 영웅들이 흘린 피를 가립니다."
  },
  "moor_tundra": {
   "en": "A perenially chilly climate has allowed short, colorful shrubs to flourish across this planet's surface.",
   "ko": "끊이지 않는 추운 기후로 인해 짧고 화려한 색상의 관목이 행성 표면에 번성하고 있습니다."
  },
  "primordial_base": {
   "en": "Abundant with life, this wet planet is covered in deep oceans, thick forests, and tall grasses.",
   "ko": "생명이 풍부하고 물이 많은 이 행성은 깊은 바다, 울창한 숲, 그리고 키 큰 풀로 덮여 있습니다."
  },
  "primordial_blue": {
   "en": "The strange subversion of photosynthesis that sustains the oddly-hued flora that flourishes on this planet remains an intriguing mystery to Super Earth's greatest exo-biologists.",
   "ko": "이 행성에서 번성하는 이상한 색상의 식물군을 지탱하는 광합성의 기이한 전멸은 슈퍼지구 최고의 외계 생물학자들에게 흥미로운 미스터리로 남아 있습니다."
  },
  "primordial_dead": {
   "en": "The lifeless grey of this planet is interrupted only by the violet flowers that grow from strange, parasitic outcroppings.",
   "ko": "이 행성의 생기 없는 회색 지대에  그나마 있는 것은 이상하고 기생적인 돌출부에서 자라는 보라색 꽃뿐입니다."
  },
  "primordial_purple": {
   "en": "This world teems with ethereal, boundless, and peculiar plant life that spreads silent and uninterrupted across its entire surface.",
   "ko": "이 세계는 고요하고 방해받지 않은 채 표면 전체에 퍼져 있는, 무한하며 이국적인 독특한 식물 생명체로 가득합니다."
  },
  "sandy_acid": {
   "en": "Dense, toxic fumes from deep within the planet's crust seep out of cracks in the earth and coat the ground in a sickly haze.",
   "ko": "행성의 지각 깊숙한 곳에서부터 짙은 유독 가스가 갈라진 틈 사이로 스며 나와, 지면을 역한 아지랑이로 뒤덮고 있습니다."
  },
  "sandy_base": {
   "en": "A blazing-hot desert planet, its rocky mesas are the sole interruptions to the endless sea of dunes.",
   "ko": "타는 듯이 뜨거운 사막 행성으로, 끝없는 모래 언덕의 바다에 유일하게 있는 것은 바위 메사 뿐입니다."
  },
  "sandy_mineral": {
   "en": "The arid, rocky biome covering this world has driven the evolution of exceptionally efficient water usage in its various organisms.",
   "ko": "이 세계를 덮고 있는 건조한 바위 생물군계는 다양한 생물체가 물을 특히나 효율적으로 사용하도록 진화를 이끌었습니다."
  },
  "sandy_moon": {
   "en": "A rocky, lonely moon with extremely valuable mineral deposits underneath the surface.",
   "ko": "표면 아래에 매우 귀한 광물이 매장되어 있는 고독한 바위투성이의 위성입니다."
  },
  "sandy_spiky": {
   "en": "A desert planet prone to unpredictable and dangerous sand twisters.",
   "ko": "예측불허의 위험한 모래 회오리바람이 발생하기 쉬운 사막 행성입니다."
  },
  "swamp_base": {
   "en": "Tall, gnarled trees flourish across the surface of this forested world. Sunlight filters past dangling vines, to the saturated undergrowth below.",
   "ko": "높고 뒤틀린 나무들이 지면을 뒤덮은 울창한 숲 지역입니다. 매달린 덩굴 사이로 비치는 햇살이 지면의 빽빽한 덤불까지 간신히 닿습니다."
  },
  "swamp_haunted": {
   "en": "Squelching mud, twisting roots; the odor of rot and anarchy. A teeming, endless morass.",
   "ko": "질척이는 진흙, 뒤틀린 뿌리, 부패와 무정부 상태의 냄새가 진동하는 행성입니다. 무언가로 들끓으며 끝이 없는 늪지가 있습니다."
  }
 },
